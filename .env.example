# Copie para .env e preencha (o arquivo .env NÃO vai para o Git)

CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=
CAKTO_CHECKOUT_URL=https://pay.cakto.com.br/h4c46wm_1021071
CAKTO_WEBHOOK_SECRET=zappro-cakto-webhook-secreto
CAKTO_PLAN_DAYS=30
CAKTO_EMBED_IFRAME=1

# Assistente de IA (Groq grátis) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Proteções leves contra rajadas de autorespostas
AUTORESPOSTA_COOLDOWN_CONTATO_SEGUNDOS=15
AUTORESPOSTA_REPETIDA_INTERVALO_MINUTOS=5
AUTORESPOSTA_MAX_POR_CONTATO_HORA=10
